    "blocks": {
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "core/button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--background)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)"
        }
      },
      "core/post-title": {
