          "lineHeight": "var(--wp--custom--typography--line-height--4-xlarge)"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "core/quote": {
        "border": {
          "width": "3px",
          "color": "var(--wp--preset--color--secondary)"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--space-grotesk)",
          "fontSize": "var(--wp--preset--font-size--4-xlarge)",
          "fontStyle": "normal",
          "fontWeight": "normal",
          "lineHeight": "var(--wp--custom--typography--line-height--4-xlarge)"
        }
      }
    },
